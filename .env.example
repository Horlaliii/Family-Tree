# Copy to .env.local for local development, and set the same variables in
# Vercel (Project → Settings → Environment Variables) for production.
# `npx supabase status -o env` prints the local values.

# --- Public (safe in the browser) -------------------------------------------
# Supabase project URL: Dashboard → Project Settings → API (or Data API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The anon / publishable key. It can read NOTHING on its own: every table is
# locked to signed-in members or to passcode visitors.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Where the site lives (used in sign-in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_) ---------------------------
# Service role key: Dashboard → Project Settings → API keys. Bypasses RLS; used
# only on the server for the passcode check, signed media URLs and exports.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The project's JWT secret (legacy HS256 secret): Dashboard → Project Settings →
# JWT Keys. Signs the short-lived "visitor" database tokens.
SUPABASE_JWT_SECRET=your-jwt-secret
# Any long random string (32+ characters) that signs the family passcode
# cookie. Generate one with:  openssl rand -hex 32
PASSCODE_COOKIE_SECRET=replace-with-a-long-random-string
